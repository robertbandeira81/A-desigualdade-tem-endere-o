spearman_resultado <- function(
    x,
    y,
    associacao) {
  
  completos <-
    complete.cases(
      x,
      y
    )
  
  teste <- cor.test(
    x[completos],
    y[completos],
    method = "spearman",
    exact = FALSE
  )
  
  tibble(
    associacao = associacao,
    n = sum(completos),
    rho = unname(
      teste$estimate
    ),
    p = teste$p.value
  )
}


resultados_spearman <- bind_rows(
  
  spearman_resultado(
    dados_final$pct_negra,
    dados_final$pct_esgoto_inad,
    "População negra × esgotamento inadequado"
  ),
  
  spearman_resultado(
    dados_final$pct_preta,
    dados_final$pct_esgoto_inad,
    "População preta × esgotamento inadequado"
  ),
  
  spearman_resultado(
    dados_final$pct_parda,
