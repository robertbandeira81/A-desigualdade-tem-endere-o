numero_pt <- function(
    x,
    digitos = 3) {
  
  gsub(
    "\\.",
    ",",
    sprintf(
      paste0(
        "%.",
        digitos,
        "f"
      ),
      x
    )
  )
}


fmt_coef <- function(
    modelo,
    termo) {
  
  x <-
    coef(
      summary(
        modelo
      )
    )[termo, ]
  
  p <-
    x["Pr(>|t|)"]
  
  estrela <-
    case_when(
      
      p < 0.001 ~
        "***",
      
      p < 0.01 ~
        "**",
      
      p < 0.05 ~
        "*",
      
      TRUE ~
        ""
    )
  
  paste0(
    
    numero_pt(
      x["Estimate"],
      3
    ),
    
    estrela,
    
    " (",
    
    numero_pt(
      x["Std. Error"],
      3
    ),
    
    ")"
  )
}


fmt_or_ic <- function(
    modelo,
    termo) {
  
  x <-
    coef(
      summary(
        modelo
      )
    )[termo, ]
  
  b <-
    x["Estimate"]
  
  se <-
    x["Std. Error"]
  
  or <-
    exp(b)
  
  li <-
    exp(
      b -
        1.96 * se
    )
  
  ls <-
    exp(
      b +
        1.96 * se
    )
  
  paste0(
    
    numero_pt(
      or,
      2
    ),
    
    " [",
    
    numero_pt(
      li,
      2
    ),
    
