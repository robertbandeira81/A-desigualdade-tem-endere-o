# ============================================================
# 7. RECONSTRUÇÃO DAS SUPRESSÕES DO ESGOTAMENTO
# ============================================================

# Categorias consideradas adequadas na variável analítica
vars_adequadas <- c(
  "rede",
  "fossa_ligada",
  "fossa_nao_ligada"
)


# Categorias consideradas inadequadas
vars_inadequadas <- c(
  "rudimentar",
  "vala",
  "rio_lago_mar",
  "outra",
  "sem_banheiro"
)


esgoto_rec <- esgoto |>
  rowwise() |>
  mutate(
    
    soma_adequada_obs =
      sum(
        c_across(
          all_of(vars_adequadas)
        ),
        na.rm = TRUE
      ),
    
    soma_inadequada_obs =
      sum(
        c_across(
          all_of(vars_inadequadas)
        ),
        na.rm = TRUE
      ),
    
    soma_obs =
      soma_adequada_obs +
      soma_inadequada_obs,
    
    n_miss_adequada =
      sum(
        is.na(
          c_across(
            all_of(vars_adequadas)
          )
        )
      ),
    
    n_miss_inadequada =
      sum(
        is.na(
          c_across(
            all_of(vars_inadequadas)
          )
        )
      ),
    
    n_miss_total =
      n_miss_adequada +
      n_miss_inadequada,
    
    faltante =
      dpp -
      soma_obs,
    
    # Limite inferior da quantidade de domicílios inadequados
    # entre as categorias suprimidas
    
    inad_suprimida_min =
      case_when(
        
        n_miss_inadequada == 0 ~
          0,
        
        TRUE ~
          max(
            n_miss_inadequada,
            faltante -
              2 * n_miss_adequada
          )
      ),
    
    # Limite superior
    
    inad_suprimida_max =
      case_when(
        
        n_miss_inadequada == 0 ~
          0,
        
        TRUE ~
          min(
            2 * n_miss_inadequada,
            faltante -
              n_miss_adequada
          )
      ),
    
    esgoto_inad_min =
      soma_inadequada_obs +
      inad_suprimida_min,
    
    esgoto_inad_max =
      soma_inadequada_obs +
      inad_suprimida_max,
    
    # Ponto médio do intervalo possível
    
    esgoto_inad =
      (
        esgoto_inad_min +
          esgoto_inad_max
      ) / 2,
    
    largura_intervalo =
      esgoto_inad_max -
      esgoto_inad_min,
    
    pct_esgoto_inad =
      100 *
      esgoto_inad /
      dpp
  ) |>
  ungroup()


# ============================================================
# 8. AUDITORIA DA RECONSTRUÇÃO
