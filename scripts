  )


# ------------------------------------------------------------
# Tratamento das pequenas frequências suprimidas
# ------------------------------------------------------------
#
# Para as células suprimidas cujo valor possível é 1 ou 2,
# utiliza-se 1,5 como ponto médio na análise principal.
# Os limites inferior e superior são preservados para
# verificações de sensibilidade.
# ------------------------------------------------------------

racial <- racial |>
  mutate(
    
    preta_suprimida =
      is.na(preta),
    
    parda_suprimida =
      is.na(parda),
    
    preta_rec =
      if_else(
        preta_suprimida,
        1.5,
        preta
      ),
    
    parda_rec =
      if_else(
        parda_suprimida,
        1.5,
        parda
      ),
    
    preta_min =
      if_else(
        preta_suprimida,
        1,
        preta
      ),
    
    parda_min =
      if_else(
        parda_suprimida,
        1,
        parda
      ),
    
    preta_max =
      if_else(
        preta_suprimida,
        2,
        preta
      ),
    
    parda_max =
      if_else(
        parda_suprimida,
        2,
        parda
      ),
    
    negra =
      preta_rec +
      parda_rec,
    
    negra_min =
      preta_min +
      parda_min,
    
    negra_max =
      preta_max +
      parda_max,
    
    pct_preta =
      100 *
      preta_rec /
      total_moradores,
    
    pct_parda =
      100 *
      parda_rec /
      total_moradores,
    
    pct_negra =
      100 *
      negra /
      total_moradores,
    
    pct_negra_min =
      100 *
      negra_min /
      total_moradores,
    
    pct_negra_max =
      100 *
      negra_max /
      total_moradores
  )


