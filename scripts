# ============================================================
# 18. FIGURA 1 - DESIGUALDADES TERRITORIAIS EM TERESINA
# ============================================================
#
# Os painéis A, B e C apresentam a distribuição dos setores
# censitários em quartis segundo:
#
# A - precariedade do esgotamento sanitário;
# B - proporção de população negra;
# C - rendimento médio das pessoas responsáveis.
#
# O painel D identifica os setores que pertencem
# simultaneamente:
#
# - ao quartil superior de população negra;
# - ao quartil inferior de rendimento;
# - ao quartil superior de precariedade sanitária.
# ============================================================


# ------------------------------------------------------------
# 18.1 MALHA DOS SETORES CENSITÁRIOS
# ------------------------------------------------------------

setores_teresina <- geobr::read_census_tract(
  code_tract =
    cod_teresina,
  
  year =
    2022,
  
  simplified =
    TRUE
) |>
  mutate(
    code_tract =
      as.character(
        code_tract
      )
  )


# Limite externo do município
limite_teresina <- setores_teresina |>
  summarise(
    geometry =
      sf::st_union(
        geometry
      )
  )


# ------------------------------------------------------------
# 18.2 PONTOS DE CORTE DOS QUARTIS
# ------------------------------------------------------------

breaks_esgoto <- quantile(
  dados_final$pct_esgoto_inad,
  probs = c(
    0,
    0.25,
    0.50,
    0.75,
    1
  ),
  na.rm = TRUE,
  names = FALSE
)


breaks_negra <- quantile(
  dados_final$pct_negra,
  probs = c(
    0,
    0.25,
    0.50,
    0.75,
    1
  ),
  na.rm = TRUE,
  names = FALSE
)


breaks_renda <- quantile(
  dados_final$renda_resp,
  probs = c(
    0,
    0.25,
    0.50,
    0.75,
    1
  ),
  na.rm = TRUE,
  names = FALSE
)


breaks_esgoto
breaks_negra
breaks_renda


# Verificar se os cinco pontos de corte são distintos
stopifnot(
  length(
    unique(
      breaks_esgoto
    )
  ) == 5,
  
  length(
    unique(
      breaks_negra
    )
  ) == 5,
  
  length(
    unique(
      breaks_renda
    )
  ) == 5
)


# ------------------------------------------------------------
# 18.3 CLASSIFICAÇÃO EM QUARTIS
# ------------------------------------------------------------

dados_mapa <- dados_final |>
  mutate(
    
    q_esgoto =
      cut(
        pct_esgoto_inad,
        breaks = breaks_esgoto,
        include.lowest = TRUE,
        labels = c(
          "Q1",
          "Q2",
          "Q3",
          "Q4"
        )
      ),
    
    q_negra =
      cut(
        pct_negra,
        breaks = breaks_negra,
        include.lowest = TRUE,
        labels = c(
          "Q1",
          "Q2",
          "Q3",
          "Q4"
        )
      ),
    
    q_renda =
      cut(
        renda_resp,
        breaks = breaks_renda,
        include.lowest = TRUE,
        labels = c(
          "Q1",
          "Q2",
          "Q3",
          "Q4"
        )
      )
  )


# ------------------------------------------------------------
# 18.4 SOBREPOSIÇÃO DAS TRÊS CONDIÇÕES
# ------------------------------------------------------------

dados_mapa <- dados_mapa |>
  mutate(
    
    sobreposicao_tripla =
      q_negra == "Q4" &
      q_renda == "Q1" &
      q_esgoto == "Q4",
    
    sobreposicao_tripla =
      factor(
        sobreposicao_tripla,
        
        levels = c(
          FALSE,
          TRUE
        ),
        
        labels = c(
          "Demais setores",
          "Três condições"
        )
      )
  )


table(
  dados_mapa$sobreposicao_tripla
)


# ------------------------------------------------------------
# 18.5 JUNÇÃO COM A MALHA CARTOGRÁFICA
# ------------------------------------------------------------

mapa_df <- setores_teresina |>
  inner_join(
    dados_mapa,
    by = "code_tract"
  )


nrow(
  mapa_df
)


# ------------------------------------------------------------
# 18.6 PONTOS DE CORTE DO PAINEL D
# ------------------------------------------------------------

q75_negra <-
  breaks_negra[4]


q25_renda <-
  breaks_renda[2]


q75_esgoto <-
  breaks_esgoto[4]


pontos_corte_mapa <- tibble(
  
  criterio = c(
    "Quartil superior de população negra",
    "Quartil inferior de rendimento",
    "Quartil superior de precariedade sanitária"
  ),
  
  ponto_corte = c(
    q75_negra,
    q25_renda,
    q75_esgoto
  )
)


pontos_corte_mapa


# ------------------------------------------------------------
# 18.7 AUDITORIA DO PAINEL D
# ------------------------------------------------------------

auditoria_mapa_d <- mapa_df |>
  sf::st_drop_geometry() |>
  filter(
    sobreposicao_tripla ==
      "Três condições"
  ) |>
  summarise(
    
    setores =
      n(),
    
    erro_negra =
      sum(
        pct_negra <
          q75_negra,
        na.rm = TRUE
      ),
    
    erro_renda =
      sum(
        renda_resp >
          q25_renda,
        na.rm = TRUE
      ),
    
    erro_esgoto =
      sum(
        pct_esgoto_inad <
          q75_esgoto,
        na.rm = TRUE
      )
  )


auditoria_mapa_d


# ------------------------------------------------------------
# 18.8 PERFIL DOS SETORES COM SOBREPOSIÇÃO
# ------------------------------------------------------------

perfil_sobreposicao_tripla <- mapa_df |>
  sf::st_drop_geometry() |>
  group_by(
    sobreposicao_tripla
  ) |>
  summarise(
    
    setores =
      n(),
    
    negra_media =
      mean(
        pct_negra,
        na.rm = TRUE
      ),
    
    renda_media =
      mean(
