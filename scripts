        esgoto_inad_min >
          esgoto_inad_max,
        na.rm = TRUE
      ),
    
    percentual_fora_limite =
      sum(
        pct_esgoto_inad < 0 |
          pct_esgoto_inad > 100,
        na.rm = TRUE
      ),
    
    supressao_incompativel =
      sum(
        n_miss_total > 0 &
          (
            faltante <
              n_miss_total |
              faltante >
              2 * n_miss_total
          ),
        na.rm = TRUE
      )
  )


